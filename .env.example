# Supabase dashboard > Project Settings > API Keys
# Base URL only, no /rest/v1/ at the end
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) - used for reading snacks
SUPABASE_KEY=your-publishable-key
# Secret key (sb_secret_...) - SERVER ONLY, used for signup/login. Never commit or share it.
SUPABASE_SERVICE_KEY=your-secret-key
